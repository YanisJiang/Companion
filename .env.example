PORT=8787
APP_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
# 仅在全站 HTTPS 时设为 true；当前用 http://IP 访问请保持 false 或删掉
COOKIE_SECURE=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
COMPANION_NAME=阿深
USER_NICKNAME=你
# 可选：首次写入 settings.persona 的默认人设；已有库以设置页为准
# PERSONA=
PROACTIVE_ENABLED=true
PROACTIVE_HOUR_START=21
PROACTIVE_HOUR_END=22
DATA_DIR=./data
# Web Push（方向 6）。用 node -e "console.log(require('web-push').generateVAPIDKeys())" 生成
# 真机推送通常需要 HTTPS；纯 http://IP 往往只能页在后台时本地通知
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:companion@localhost
