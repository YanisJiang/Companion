{
  "name": "@yanisjiang/companion-core",
  "version": "0.1.0",
  "description": "State-driven AI companion runtime: traits, mood state, decide intents, pluggable LLM and storage.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YanisJiang/Companion.git",
    "directory": "packages/companion-core"
  },
  "homepage": "https://github.com/YanisJiang/Companion/tree/master/packages/companion-core",
  "bugs": {
    "url": "https://github.com/YanisJiang/Companion/issues"
  },
  "author": "YanisJiang",
  "keywords": [
    "companion",
    "llm",
    "chat",
    "persona",
    "agent",
    "openai-compatible"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
